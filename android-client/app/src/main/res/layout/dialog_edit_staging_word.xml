<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa từ vựng chờ"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="# TỪ VỰNG"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtEditTerm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Từ vựng..."
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="▪ ĐỊNH NGHĨA / NGHĨA"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtEditMeaning"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Nghĩa của từ..."
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="* VÍ DỤ MINH HỌA"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtEditExample"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Ví dụ minh họa (tùy chọn)..."
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

</LinearLayout>
