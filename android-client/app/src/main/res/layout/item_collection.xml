<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCollection"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/viewAccentBar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="#8EC5FC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/layoutIconBg"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_folder_icon_container">

                    <ImageView
                        android:id="@+id/imgFolderIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Folder Icon"
                        android:src="@drawable/ic_folder_add"
                        app:tint="@color/app_accent" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnOptions"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Options"
                    android:padding="2dp"
                    android:src="@drawable/ic_delete"
                    app:tint="#EF4444" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCollectionName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/app_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Business English 2024" />

            <TextView
                android:id="@+id/txtCollectionDesc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/app_text_secondary"
                android:textSize="12sp"
                tools:text="Learn business vocabulary for work." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressLearning"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_custom" />

                <TextView
                    android:id="@+id/txtProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="0%" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtWordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/app_text_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="0 từ vựng" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
