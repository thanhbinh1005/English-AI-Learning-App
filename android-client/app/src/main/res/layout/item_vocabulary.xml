<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVocab"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chkLearned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#10B981" />

            <TextView
                android:id="@+id/txtTerm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Entrepreneur" />

            <ImageView
                android:id="@+id/btnSpeech"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speak"
                android:padding="6dp"
                android:src="@drawable/ic_volume"
                app:tint="#0D6EFD" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="4dp"
            android:textColor="#334155"
            android:textSize="15sp"
            tools:text="Doanh nhân, người khởi nghiệp" />

        <TextView
            android:id="@+id/txtExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="4dp"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="italic"
            tools:text="Example: She is a successful tech entrepreneur." />

    </LinearLayout>

</androidx.cardview.widget.CardView>