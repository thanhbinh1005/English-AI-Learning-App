# Normalize text files in Git
* text=auto

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts
*.sh text eol=lf

# Android / Kotlin
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf

# Python / Flask
*.py text eol=lf

# Documentation
*.md text eol=lf